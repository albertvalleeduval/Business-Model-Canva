# Server-side key used by the Vercel serverless function (api/generate.js).
# Set it in Vercel > Project Settings > Environment Variables for deployments.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional, LOCAL DEV ONLY: lets `npm run dev` call Gemini directly from the
# browser without running `vercel dev`. Never used in production builds.
VITE_GEMINI_API_KEY=
